# Solo nomi e descrizioni: assegnare i valori nel gestore segreti, mai in Git.
# Next dev carica .env.local; migrazioni e Vitest richiedono env esportate.

# Origine canonica senza percorso o slash finale; HTTPS obbligatorio in produzione.
APP_URL=
# PostgreSQL runtime: login dedicato ludoteca_app, non owner; TLS verify-full in produzione.
DATABASE_URL=
# Solo job migrazioni: connessione privilegiata, NON assegnare al servizio web.
MIGRATION_DATABASE_URL=
# Percorso assoluto al certificato CA PostgreSQL montato nel container (se necessario).
NODE_EXTRA_CA_CERTS=

# URL progetto Supabase; tutte queste variabili sono lette sul server a runtime.
SUPABASE_URL=
# Chiave anon del progetto per Supabase Auth; non usare la service-role qui.
SUPABASE_ANON_KEY=
# Segreto server-only per upload Storage; mai NEXT_PUBLIC_ o build argument.
SUPABASE_SERVICE_ROLE_KEY=
# Nome esatto del bucket immagini: lettura pubblica, scritture pubbliche disabilitate.
SUPABASE_STORAGE_BUCKET=
# UUID Supabase Auth degli amministratori, separati da virgole, non email.
ADMIN_USER_IDS=

# Chiave API Resend e mittente appartenente a un dominio verificato.
RESEND_API_KEY=
EMAIL_FROM=
# 32 byte casuali codificati base64; persistente e identica su tutte le repliche.
EMAIL_ENCRYPTION_KEY=
# Segreto casuale di almeno 32 caratteri per Authorization Bearer del worker outbox.
OUTBOX_SECRET=
# Impostare true SOLO dopo sanitizzazione x-forwarded-for al proxy fidato; altrimenti false.
TRUST_PROXY=

# Solo test: database sacrificabile con privilegi migrazione; i test TRONCANO i dati.
TEST_DATABASE_URL=
# Solo test browser: URL di un server Next separato avviato prima dei test.
UI_TEST_URL=
# Solo test browser admin: porta locale del mock Auth, mai usare in produzione.
UI_TEST_AUTH_PORT=
# Solo runner test:e2e: porta Next loopback; predefinita 3100.
UI_TEST_PORT=
